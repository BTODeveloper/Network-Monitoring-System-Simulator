<Window x:Class="NetworkMonitoringDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetworkMonitoringDashboard"
        xmlns:converters="clr-namespace:NetworkMonitoringDashboard.Converters"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        Title="Network Monitoring Dashboard" 
        Height="900" 
        Width="1400"
        Background="#0A1929">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Area -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="NETWORK OPERATIONS CENTER" 
                         Foreground="#4FC3F7" 
                         FontSize="28" 
                         FontWeight="Light"/>
                <TextBlock Text="Real-time Network Monitoring System" 
                         Foreground="#78909C" 
                         FontSize="14" 
                         Margin="2,5,0,0"/>
            </StackPanel>

            <Border Grid.Column="2" 
                    Background="#1A2D3E" 
                    CornerRadius="8" 
                    Padding="15,10">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Source={x:Static system:DateTime.Now}, 
                             StringFormat='{}{0:HH:mm:ss}'}" 
                             Foreground="#4FC3F7"
                             FontSize="24"
                             FontFamily="Consolas"/>
                    <TextBlock Text="{Binding Source={x:Static system:DateTime.Now}, 
                             StringFormat='{}{0:yyyy-MM-dd}'}" 
                             Foreground="#546E7A"
                             FontSize="12"
                             HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Server Status -->
            <Border Background="#1A2D3E" 
                    CornerRadius="12" 
                    Margin="0,0,20,0">
                <DockPanel Margin="15">
                    <TextBlock DockPanel.Dock="Top" 
                             Text="NETWORK NODES" 
                             Foreground="#4FC3F7" 
                             FontSize="16" 
                             FontWeight="SemiBold"
                             Margin="0,0,0,15"/>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Servers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0A1929" 
                                            CornerRadius="8" 
                                            Margin="0,0,0,10" 
                                            Padding="15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel>
                                                <TextBlock Text="{Binding ServerName}" 
                                                         Foreground="White" 
                                                         FontWeight="SemiBold"
                                                         DockPanel.Dock="Left"/>
                                                <Border Background="{Binding IsOnline, 
                                                        Converter={StaticResource StatusToColorConverter}}"
                                                        Width="40"
                                                        Height="20"
                                                        CornerRadius="10"
                                                        DockPanel.Dock="Right">
                                                    <TextBlock Text="{Binding IsOnline, 
                                                             Converter={StaticResource BoolToVis}}"
                                                             Foreground="#0A1929"
                                                             FontSize="10"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </DockPanel>

                                            <StackPanel Grid.Row="1" 
                                                      Orientation="Horizontal" 
                                                      Margin="0,8">
                                                <TextBlock Text="LOCATION: " 
                                                         Foreground="#546E7A"
                                                         FontSize="11"/>
                                                <TextBlock Text="{Binding Location}" 
                                                         Foreground="#B0BEC5"
                                                         FontSize="11"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="RESPONSE TIME" 
                                                         Foreground="#546E7A"
                                                         FontSize="11"/>
                                                <TextBlock Grid.Column="1" 
                                                         Text="{Binding ResponseTime, 
                                                         StringFormat={}{0:F0}ms}" 
                                                         Foreground="#64B5F6"
                                                         FontFamily="Consolas"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Panel - Charts and Metrics -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <!-- Bandwidth Chart -->
                <Border Background="#1A2D3E" 
                        CornerRadius="12" 
                        Margin="0,0,0,10">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="BANDWIDTH UTILIZATION" 
                                     Foreground="#4FC3F7" 
                                     FontSize="16" 
                                     FontWeight="SemiBold"/>
                            <TextBlock Text="Mbps" 
                                     Foreground="#546E7A"
                                     FontSize="12"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"/>
                        </DockPanel>

                        <lvc:CartesianChart Grid.Row="1" 
                                          Series="{Binding BandwidthSeries}"
                                          DisableAnimations="True"
                                          Hoverable="False"
                                          DataTooltip="{x:Null}"
                                          Background="Transparent">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="1" 
                                                     Stroke="#253A4B"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" 
                                         MaxValue="100"
                                         Foreground="#546E7A">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="1" 
                                                     Stroke="#253A4B"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- Latency Chart -->
                <Border Grid.Row="1" 
                        Background="#1A2D3E" 
                        CornerRadius="12" 
                        Margin="0,10">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="NETWORK LATENCY" 
                                     Foreground="#4FC3F7" 
                                     FontSize="16" 
                                     FontWeight="SemiBold"/>
                            <TextBlock Text="milliseconds" 
                                     Foreground="#546E7A"
                                     FontSize="12"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"/>
                        </DockPanel>

                        <lvc:CartesianChart Grid.Row="1" 
                                          Series="{Binding LatencySeries}"
                                          DisableAnimations="True"
                                          Hoverable="False"
                                          DataTooltip="{x:Null}"
                                          Background="Transparent">
                            <lvc:CartesianChart.AxisX>
                                <lvc:Axis ShowLabels="False">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="1" 
                                                     Stroke="#253A4B"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisX>
                            <lvc:CartesianChart.AxisY>
                                <lvc:Axis MinValue="0" 
                                         MaxValue="200"
                                         Foreground="#546E7A">
                                    <lvc:Axis.Separator>
                                        <lvc:Separator StrokeThickness="1" 
                                                     Stroke="#253A4B"/>
                                    </lvc:Axis.Separator>
                                </lvc:Axis>
                            </lvc:CartesianChart.AxisY>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- Events Panel -->
                <Border Grid.Row="2" 
                        Background="#1A2D3E" 
                        CornerRadius="12" 
                        Margin="0,10,0,0">
                    <DockPanel Margin="20">
                        <TextBlock DockPanel.Dock="Top" 
                                 Text="NETWORK EVENTS LOG" 
                                 Foreground="#4FC3F7" 
                                 FontSize="16" 
                                 FontWeight="SemiBold"
                                 Margin="0,0,0,10"/>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentMetrics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0A1929" 
                                                CornerRadius="6" 
                                                Margin="0,0,0,5" 
                                                Padding="12">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Timestamp, 
                                                         StringFormat='HH:mm:ss'}" 
                                                         Foreground="#546E7A"
                                                         FontFamily="Consolas"/>
                                                <TextBlock Text="|" 
                                                         Foreground="#253A4B"
                                                         Margin="8,0"/>
                                                <TextBlock Text="{Binding PacketLoss, 
                                                         StringFormat='Packet Loss: {0:F1}%'}" 
                                                         Foreground="#FF8F00"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>